# HireBuddha website: environment variables.
# Copy to .env.local for development. NEXT_PUBLIC_* values are fixed at BUILD
# time: set them before `npm run build`, not only before `npm start`.

# --- Pragya (the fluid-buddha voice agent) -----------------------------------
# WebSocket base of Pragya's backend. Without it, a production build shows
# "Pragya is offline" instead of connecting anywhere. Also added to the CSP.
NEXT_PUBLIC_HIREBUDDHA_VOICE_WSS="wss://api.fluidbuddha.com"
# basic | high | advance | extreme   (default: advance)
NEXT_PUBLIC_FB_INTELLIGENCE=extreme
# level1 | level2 | level3           (default: level1)
NEXT_PUBLIC_FB_DESIGN=level3

# --- Contact form: leads are e-mailed to LEAD_TO over SMTP --------------------
# Sent from support@hirebuddha.com on Microsoft 365. Its mailbox needs
# "Authenticated SMTP" turned on (Microsoft 365 admin centre -> Users ->
# support@ -> Mail -> Manage email apps). Without SMTP_HOST the form tells
# visitors to write to contact@ instead.
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
# "true" for port 465 (implicit TLS); Microsoft 365 uses 587 with STARTTLS.
SMTP_SECURE=false
SMTP_USER="support@hirebuddha.com"
SMTP_PASS=""
# Defaults: LEAD_TO = contact@hirebuddha.com, LEAD_FROM = SMTP_USER.
LEAD_TO="contact@hirebuddha.com"
LEAD_FROM="support@hirebuddha.com"
# Extra origins allowed to post the form (comma-separated), e.g. a staging host.
LEAD_ALLOWED_ORIGINS=""
